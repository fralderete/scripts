```bash
# Bot status
sudo systemctl status ootd-bot

# Start bot
sudo systemctl start ootd-bot

# Stop bot
sudo systemctl stop ootd-bot

# Restart bot
sudo systemctl restart ootd-bot

# Live logs
sudo journalctl -u ootd-bot -f

# Last 30 log lines
sudo journalctl -u ootd-bot -n 30 --no-pager

# Logs from current boot
sudo journalctl -u ootd-bot -b --no-pager

# Check Python syntax
python3 -m compileall -q -x 'venv' .

# Edit systemd service
sudo vim /etc/systemd/system/ootd-bot.service

# Reload systemd after editing service file
sudo systemctl daemon-reload

# Enable automatic startup
sudo systemctl enable ootd-bot

# Disable automatic startup
sudo systemctl disable ootd-bot

# Reboot Raspberry Pi
sudo reboot
```
